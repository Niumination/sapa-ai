# ─── Contoh konfigurasi sapa-ai ───
# Salin ke .env.local. Tidak ada satu pun yang WAJIB: tanpa berkas ini pun
# aplikasi berjalan 100% deterministik dari data SAPA SPLP.
#
# Semua variabel di bawah SENGAJA dikomentari. Contoh yang bisa disalin
# langsung bukanlah anjuran untuk mengisinya — ia hanya dokumentasi tentang
# apa yang tersedia.

# ─── Sumber data (publik, tidak butuh kredensial) ───
# Endpoint daftar_data SPLP bersifat publik. Nilai di bawah hanya dipakai bila
# kelak diperlukan jalur OAuth — saat ini tidak ada kode yang memanggilnya.
# SAPA_CLIENT_ID=3
# SAPA_CLIENT_SECRET=

# ─── Model AI ───
# KEADAAN BAWAAN: MATI. Tidak diisi = tidak aktif = narasi deterministik.
# Bagian ini hanya dokumentasi untuk kelak, BUKAN anjuran untuk dihidupkan.
# AI boleh dihidupkan hanya setelah lulus gerbang promosi dalam mode shadow
# dengan model sungguhan (pass >= 90%, replaced <= 10%, fail = 0, tanpa regresi
# dari 74/78) dan atas persetujuan pemilik aplikasi.
#
# # AI_ENABLED=false  → narasi deterministik (keadaan bawaan).
# # AI_SHADOW=true    → model dipanggil untuk evaluasi, pengguna TETAP menerima
# #                     jawaban deterministik. Inilah mode untuk mengukur.
# # AI_ENABLED=true   → narasi AI dikirim ke pengguna (hanya setelah lulus gerbang).
# AI_ENABLED=false
# AI_SHADOW=false
#
# # Provider: opencode-go | gemini | custom
# #  • opencode-go → https://opencode.ai/zen/go/v1  (langganan; pilih model yang
# #    memakai endpoint /chat/completions, mis. glm-5.2, deepseek-v4-flash,
# #    kimi-k2.6, mimo-v2.5. Model MiniMax/Qwen di OpenCode Go memakai dialek
# #    /messages — belum didukung, akan ditolak dengan alasan jelas.)
# #  • gemini      → endpoint OpenAI-compatible Google AI Studio
# #  • custom      → OpenAI-compatible apa pun (Vercel AI Gateway, OpenRouter, lokal)
# AI_PROVIDER=opencode-go
#
# # Kosongkan bila memakai bawaan provider di atas.
# AI_BASE_URL=
# AI_ENDPOINT_PATH=/chat/completions
#
# # Model WAJIB diisi eksplisit — kode tidak pernah memilihkan model diam-diam.
# # Contoh opencode-go : glm-5.2 · deepseek-v4-flash · kimi-k2.6 · mimo-v2.5
# # Contoh gemini      : gemini-2.5-flash-lite · gemini-3.5-flash-lite
# AI_MODEL=
# AI_API_KEY=
#
# # Anggaran & pengaman
# AI_TIMEOUT_MS=20000        # klien memutus pada 45 s, platform pada 60 s
# AI_MAX_OUTPUT_TOKENS=800   # cukup untuk narasi ber-token, bukan esai
# AI_TEMPERATURE=0.2
# AI_JSON_MODE=true
# AI_DAILY_CALL_LIMIT=2000   # 0 = tanpa batas

# ─── Lainnya ───
# Wajib diisi di produksi: kalau kosong, /api/revalidate bisa dipanggil siapa saja.
REVALIDATE_SECRET=

# Rate limit & cache lintas-instance (opsional; tanpa ini jatuh ke memori proses).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
