{
  "name": "sapa-ai",
  "version": "0.1.0",
  "private": true,
  "description": "SAPA Smart AI — asisten data SPLP Kabupaten Aceh Tengah (SAPA-only: tanpa basis data, tanpa autentikasi, tanpa DTSEN)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bash scripts/typecheck.sh",
    "eval": "node scripts/eval-run.mjs",
    "eval:baseline": "node scripts/eval-run.mjs --baseline",
    "prepare": "git config core.hooksPath .githooks >/dev/null 2>&1 || true"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
